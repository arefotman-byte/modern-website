# Claude API key used by the research, listing and fulfillment agents.
# Leave empty to run the agents in "simulate" mode (scripted, no API calls).
ANTHROPIC_API_KEY=

# live | simulate  (defaults to live when a key is present)
AGENT_MODE=

# Supplier adapter: mock (built-in demo catalog). Add real adapters in lib/suppliers/.
SUPPLIER=mock

# Sales channels to use (comma separated): store, ebay, amazon, walmart, tiktok
CHANNELS=store,ebay,amazon,walmart,tiktok

# --- eBay (leave blank = dry run: nothing is sent to eBay) ---
# Create an app at developer.ebay.com, get a user refresh token with the
# sell.inventory and sell.fulfillment scopes, and create business policies
# (shipping, payment, returns) and an inventory location in your seller account.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_CATEGORY_TREE_ID=0
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_LOCATION_KEY=

# --- Amazon SP-API (blank = dry run) ---
# Register as an SP-API developer, self-authorise your app, and request the
# PII (restricted) role so orders include the buyer's shipping address.
AMAZON_ENV=sandbox
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_REGION_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# Only if Amazon granted you a GTIN exemption for unbranded products:
AMAZON_GTIN_EXEMPT=

# --- Walmart Marketplace (blank = dry run; requires an approved seller account) ---
WALMART_ENV=sandbox
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
# Version string from the current MP_ITEM item spec in Walmart's developer portal
WALMART_ITEM_SPEC_VERSION=

# --- TikTok Shop Partner API (blank = dry run) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_WAREHOUSE_ID=
TIKTOK_SHIPPING_PROVIDER_ID=

# --- Automation ---
# 1 = run the agents on a schedule while the server is running
AUTOPILOT=0
AUTOPILOT_RESEARCH_HOURS=24
AUTOPILOT_LISTING_MINUTES=60
AUTOPILOT_FULFILLMENT_MINUTES=15

# Password for /admin (username can be anything). Always set this before going online.
ADMIN_PASSWORD=
